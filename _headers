# Cloudflare Pages — cabeçalhos de segurança (site estático)
# Recursos próprios (CSS, JS, fontes, ícones SVG) são servidos do domínio.
# Única exceção externa: o beacon do Cloudflare Web Analytics — domínios do
# próprio Cloudflare (static.cloudflareinsights.com / cloudflareinsights.com),
# sem cookies. Liberação cirúrgica em script-src e connect-src.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Fontes locais: imutáveis, cache longo (o conteúdo do arquivo não muda).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS: nomes SEM hash de versão (app.min.css, main.min.js), então o
# conteúdo pode mudar a cada deploy. `no-cache` faz o navegador revalidar
# sempre antes de usar — com o ETag do Pages, retorna 304 quando nada mudou
# (barato) e serve a versão nova imediatamente após um deploy. Evita servir
# JS/CSS velho para visitantes recorrentes.
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache

# Ilustrações vetoriais: podem ser reeditadas, então cache curto com revalidação.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
